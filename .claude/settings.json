{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr * merge *)",
      "Bash(gh pr * merge)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api graphql*mergePullRequest*)",
      "mcp__plugin_github_github__merge_pull_request"
    ]
  }
}
